<div id="live-root">
  <div class="list-container" id="list-live" phx-hook="Swipe">
    <div class="toolbar" id="toolbar">
      <div class="toolbar-left">
        <% all_selected? = @items != [] and MapSet.size(@selected) == length(@items) %>
        <%# Select-all — ring circle, no text content %>
        <button type="button" phx-click="toggle_all" title="Select all"
                class={"select-btn #{if all_selected?, do: "selected", else: ""}"}></button>

        <%# Search — SVG magnifier %>
        <button type="button" phx-click="open_search" class="search-btn" title="Search">
          <svg width="18" height="18" viewBox="0 0 18 18" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
            <circle cx="7.5" cy="7.5" r="5.5"/>
            <line x1="11.5" y1="11.5" x2="16" y2="16"/>
          </svg>
        </button>
      </div>

      <div class="toolbar-actions">

        <%# ── Status group ──────────────────────────────────────── %>
        <div class="tb-group">
          <%# Checkmark %>
          <button type="button" phx-click="set_status" phx-value-status="completed"
                  class="toolbar-btn" title="Complete">
            <svg width="20" height="20" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <polyline points="3,10 8,15 17,5"/>
            </svg>
          </button>
          <%# Wiggle out %>
          <button type="button" phx-click="set_status" phx-value-status="wiggled_out"
                  class="toolbar-btn" title="Wiggle out">
            <svg width="20" height="20" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <path d="M2,8 C5,5 8,11 11,8 C14,5 17,11 20,8"/>
              <path d="M2,13 C5,10 8,16 11,13 C14,10 17,16 20,13"/>
            </svg>
          </button>
          <%# Arrow forward %>
          <button type="button" phx-click="arrow_selected" class="toolbar-btn" title="Arrow forward">
            <svg width="20" height="20" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <line x1="3" y1="10" x2="16" y2="10"/>
              <polyline points="10,4 16,10 10,16"/>
            </svg>
          </button>
        </div>

        <%# ── Style group ───────────────────────────────────────── %>
        <div class="tb-group">
          <button type="button" phx-click="set_decoration" phx-value-field="bold"
                  phx-value-setting="true" class="toolbar-btn" title="Bold">
            <b>B</b>
          </button>
          <button type="button" phx-click="set_decoration" phx-value-field="italic"
                  phx-value-setting="true" class="toolbar-btn" title="Italic">
            <i>I</i>
          </button>
          <button type="button" phx-click="set_decoration" phx-value-field="highlighted"
                  phx-value-setting="true" class="toolbar-btn" title="Highlight">
            <span style="background:oklch(85% 0.16 90 / 0.5);border-radius:3px;padding:2px 6px;font-size:19px;font-weight:800;color:oklch(90% 0.12 90)">H</span>
          </button>
        </div>

        <%# ── Color swatches ────────────────────────────────────── %>
        <div class="swatches-row">
          <button type="button" phx-click="set_decoration" phx-value-field="color"
                  phx-value-setting="red" class="color-swatch swatch-red" title="Red"></button>
          <button type="button" phx-click="set_decoration" phx-value-field="color"
                  phx-value-setting="blue" class="color-swatch swatch-blue" title="Blue"></button>
          <button type="button" phx-click="set_decoration" phx-value-field="color"
                  phx-value-setting="green" class="color-swatch swatch-green" title="Green"></button>
          <button type="button" phx-click="set_decoration" phx-value-field="color"
                  phx-value-setting="purple" class="color-swatch swatch-purple" title="Purple"></button>
          <button type="button" phx-click="set_decoration" phx-value-field="color"
                  phx-value-setting="orange" class="color-swatch swatch-orange" title="Orange"></button>
        </div>

        <%# ── Clear formats ─────────────────────────────────────── %>
        <div class="tb-group">
          <button type="button" phx-click="remove_formats" class="toolbar-btn" title="Remove all formats">
            <svg width="20" height="20" viewBox="0 0 20 20" fill="none" stroke="currentColor" stroke-width="2.5" stroke-linecap="round" stroke-linejoin="round">
              <line x1="4" y1="4" x2="16" y2="16"/>
              <line x1="16" y1="4" x2="4" y2="16"/>
            </svg>
          </button>
        </div>

        <%# ── Prefix input ──────────────────────────────────────── %>
        <form phx-submit="set_decoration" class="prefix-form">
          <input type="hidden" name="field" value="prefix" />
          <input type="text" name="setting" placeholder="pfx" class="prefix-input" maxlength="3" />
        </form>

      </div>

      <%= if @date != @today do %>
        <button type="button" phx-click="go_today" class="today-btn">↩ Today</button>
      <% end %>
    </div>

    <%# ── Date header ───────────────────────────────────────────── %>
    <div class="date-header">
      <button type="button" phx-click="prev_day" class="nav-arrow nav-left">⟨</button>
      <div class="date-display">
        <label for="date-picker">{Calendar.strftime(@date, "%A, %B %-d, %Y")}</label>
        <%# Custom styled date picker: button triggers showPicker() on hidden input %>
        <div class="date-picker-wrap">
          <button type="button" class="date-picker-btn" onclick="document.getElementById('date-picker').showPicker()">
            <svg width="14" height="14" viewBox="0 0 14 14" fill="none" stroke="currentColor" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
              <rect x="1" y="2" width="12" height="11" rx="2"/>
              <line x1="1" y1="6" x2="13" y2="6"/>
              <line x1="4" y1="1" x2="4" y2="4"/>
              <line x1="10" y1="1" x2="10" y2="4"/>
            </svg>
            {Date.to_iso8601(@date)}
          </button>
          <form phx-change="jump_date" id="date-picker-form">
            <input
              type="date"
              id="date-picker"
              value={Date.to_iso8601(@date)}
              name="date"
              class="date-picker-input"
            />
          </form>
        </div>
      </div>
      <button type="button" phx-click="next_day" class="nav-arrow nav-right">⟩</button>
    </div>

    <%# ── Items list ────────────────────────────────────────────── %>
    <ul class="items-list" id="items-list" phx-hook="DragSort">
      <%= for item <- @items do %>
        <li
          class={["item", item_class(item), color_item_class(item), if(@highlighted_item_id == item.id, do: "search-highlight")] |> Enum.reject(&is_nil/1) |> Enum.join(" ")}
          data-id={item.id}
        >
          <span class="drag-handle">⠿</span>

          <%# Per-item select circle — no text, uses CSS ::after for fill dot %>
          <button
            type="button"
            phx-click="toggle_select"
            phx-value-id={item.id}
            class={"item-select-btn #{if MapSet.member?(@selected, item.id), do: "selected", else: ""}"}
            title={if MapSet.member?(@selected, item.id), do: "Deselect", else: "Select"}
          ></button>

          <%= if item.prefix do %>
            <span class="prefix-badge">{item.prefix}</span>
          <% end %>

          <%= if @editing_id == item.id do %>
            <form phx-submit="save_edit" class="edit-form">
              <input type="hidden" name="_id" value={item.id} />
              <textarea name="body" autofocus class="edit-textarea" phx-hook="EditItem" id={"edit-textarea-#{item.id}"}><%= item.body %></textarea>
              <div style="display:flex;gap:8px;margin-top:4px">
                <button type="submit" class="save-btn">Save</button>
                <button type="button" phx-click="cancel_edit" class="cancel-btn">Cancel</button>
              </div>
            </form>
          <% else %>
            <span class={"item-body #{item_classes(item)}"} phx-click="start_edit" phx-value-id={item.id}><span class="item-text">{item.body}</span><%= if item.status == :arrowed_out && item.arrowed_to_date do %><span class="arrow-annotation"> ➜ {item.arrowed_to_date}</span><% end %></span>
          <% end %>
        </li>
      <% end %>
    </ul>

    <%# ── Add item form ──────────────────────────────────────────── %>
    <form phx-submit="add_item" class="add-item-form">
      <textarea
        name="body"
        placeholder="Add item… (Enter to save, Shift+Enter for newline)"
        phx-hook="AddItem"
        id="add-item-input"
        class="add-item-input"
        rows="2"
      ></textarea>
      <button type="submit" class="add-btn">Add</button>
    </form>
  </div>

  <%# ── Arrow-forward modal ───────────────────────────────────────── %>
  <%= if @arrow_modal do %>
    <div class="modal-overlay" phx-click="cancel_arrow">
      <div class="elixdo-modal" onclick="event.stopPropagation()">
        <h3>Arrow forward to date</h3>
        <form phx-submit="confirm_arrow">
          <input type="date" name="to_date" required autofocus />
          <button type="submit">Arrow</button>
          <button type="button" phx-click="cancel_arrow">Cancel</button>
        </form>
      </div>
    </div>
  <% end %>

  <%# ── Search modal ───────────────────────────────────────────────── %>
  <%= if @search_open do %>
    <div class="modal-overlay">
      <div class="elixdo-modal search-modal" phx-click-away="close_search">
        <h3>Search</h3>
        <form phx-change="search" phx-submit="search">
          <input
            type="text"
            name="query"
            placeholder="Search items…"
            class="search-input"
            autocomplete="off"
            phx-hook="SearchFocus"
            id="search-input"
          />
        </form>
        <ul class="search-results">
          <%= for result <- @search_results do %>
            <li class="search-result-item" phx-click="goto_result"
                phx-value-id={result.id} phx-value-date={result.date}>
              <span class="search-result-body">{result.body}</span>
              <span class="search-result-date">{result.date}</span>
            </li>
          <% end %>
          <%= if @search_results == [] do %>
            <li class="search-no-results">No results</li>
          <% end %>
        </ul>
        <button type="button" phx-click="close_search" class="search-close-btn">Close</button>
      </div>
    </div>
  <% end %>
</div>
